{
  "expo": {
    "name": "Aqua Nigha",
    "slug": "wateros",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wateros",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nighatech.wateros",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#01040F"
      },
      "package": "com.wateros.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./config-plugins/abi-filter",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05c1ea03-f811-4803-8006-9b7d5f055d1b"
      }
    },
    "owner": "bpunith5s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/05c1ea03-f811-4803-8006-9b7d5f055d1b"
    }
  }
}
